configuration {
    modei: ["window","drun","run"];
    display-run: "";
    font: "Libron Regular 10";
    fixed-num-lines: true;
    show-icons: false;
    terminal: "kitty";
    entry {
        max-history: 0;
    }
}

entry {
    cursor-width: 8px;
    cursor-outline: false;
    placeholder: "";
}


* {
    separatorcolor:              #333333;
    border-color:                #333333;

    selected-normal-foreground:  #ffffff;
    selected-normal-background:  #285577;
    selected-active-foreground:  #ffffff;
    selected-active-background:  #285577;
    selected-urgent-foreground:  #ffffff;
    selected-urgent-background:  #900000;

    normal-foreground:           #888888;
    normal-background:           #222222;

    active-foreground:           #285577;
    active-background:           #222222;

    urgent-foreground:           #900000;
    urgent-background:           #222222;

    alternate-normal-foreground: #ffffff;
    alternate-normal-background: #5f676a;

    alternate-active-foreground: #ffffff;
    alternate-active-background: #5f676a;

    alternate-urgent-foreground: #ffffff;
    alternate-urgent-background: #5f676a;

    background: #222222;
    foreground: #888888;

    spacing:                     2;
}

window {
    width: 20%;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

prompt {
    enabled: false;
}

element {
    highlight: none;
    padding: 1px;
    margin: 1px;
}
