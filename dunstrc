[global]
    frame_width = 1
    origin = bottom-right
    font = Epunda Slab Medium 12
    markup = yes
    format = "%s\n%n\n%b"
    stack_duplicates = false
    hide_duplicate_count = false
    sort = yes
    indicate_hidden = no
    alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    shrink = yes
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    line_height = 0
    separator_height = 1
    padding = 5
    horizontal_padding = 5
    dmenu = /usr/bin/dmenu -p dunst:
    browser = chromium
    icon_position = off
    icon_path = /usr/share/icons/Adwaita/16x16/status/:/usr/share/icons/Adwaita/16x16/devices/
    max_icon_size=64
    width = (200, 400)

[global]
frame_color = "#c4b28a"
separator_color = "#a292a3"

[base16_low]
    msg_urgency = "low"
    background = "#181616"
    foreground = "#c5c9c5"

[base16_normal]
    msg_urgency = "normal"
    background = "#181616"
    foreground = "#c5c9c5"

[base16_critical]
    msg_urgency = "critical"
    background = "#181616"
    foreground = "#c5c9c5"
